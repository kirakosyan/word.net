* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.Dockerfile text eol=lf
*.sln text eol=crlf
*.doc binary
*.docx binary
*.pdf binary
*.epub binary
*.mobi binary
*.azw3 binary
*.xps binary
*.odt binary
*.png binary
*.tif binary

# Keep the reproducible corpus generator hash stable on Windows and Unix.
eng/generate-comparison-corpus.py text eol=lf
eng/generate-automation-templates.py text eol=lf
eng/generate-odt-fixtures.py text eol=lf
eng/generate-p1-templates.py text eol=lf
