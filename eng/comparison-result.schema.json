{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Separate comparison metrics v1",
  "type": "object",
  "required": ["schemaVersion", "manifestSha256", "sourceRevision", "sourceDirty", "renderer", "rendererSha256", "fonts", "tolerances", "results"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestSha256": { "$ref": "#/$defs/hash" },
    "sourceRevision": { "type": "string" },
    "sourceDirty": { "type": "boolean" },
    "renderer": { "type": "string" },
    "rendererSha256": { "$ref": "#/$defs/hash" },
    "fonts": { "type": "array" },
    "tolerances": { "type": "object" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["documentId", "engine", "inputSha256", "knownLosses", "status"],
        "properties": {
          "documentId": { "type": "string" },
          "engine": { "enum": ["wordnet", "aspose"] },
          "inputSha256": { "$ref": "#/$defs/hash" },
          "knownLosses": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["measured", "failed"] },
          "measurement": { "$ref": "#/$defs/measurement" },
          "knownLossChecks": {
            "type": "object", "required": ["passed", "missing", "unexpected"],
            "properties": { "passed": { "type": "boolean" },
              "missing": { "type": "array", "items": { "type": "string" } },
              "unexpected": { "type": "array", "items": { "type": "string" } } }
          },
          "authoredChecks": { "type": "object" },
          "referenceChecks": { "type": "array" },
          "error": { "type": "string" }
        },
        "allOf": [
          { "if": { "properties": { "status": { "const": "measured" } } },
            "then": { "required": ["measurement", "authoredChecks", "referenceChecks"] } },
          { "if": { "properties": { "status": { "const": "failed" } } },
            "then": { "required": ["error"] } },
          { "if": { "properties": { "status": { "const": "measured" }, "engine": { "const": "wordnet" } }, "required": ["status", "engine"] },
            "then": { "required": ["knownLossChecks"] } }
        ]
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "measurement": {
      "type": "object",
      "required": ["schemaVersion", "engine", "artifactMode", "inputSha256", "outputSha256", "runtime", "architecture", "os", "machine", "processor", "affinity", "assemblies", "fonts", "samples", "snapshot"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "artifactMode": { "enum": ["licensed", "evaluation"] },
        "inputSha256": { "$ref": "#/$defs/hash" },
        "outputSha256": { "$ref": "#/$defs/hash" },
        "assemblies": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["name", "version", "sha256"],
            "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "sha256": { "$ref": "#/$defs/hash" } }
          }
        },
        "samples": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object",
            "required": ["kind", "milliseconds", "allocatedBytes", "rssBytes", "processPeakRssBytes", "outputBytes"],
            "properties": {
              "kind": { "enum": ["cold-conversion", "warm-conversion"] },
              "milliseconds": { "type": "number", "minimum": 0 },
              "allocatedBytes": { "type": "integer", "minimum": 0 },
              "rssBytes": { "type": "integer", "minimum": 0 },
              "processPeakRssBytes": { "type": "integer", "minimum": 0 },
              "outputBytes": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "snapshot": {
          "type": "object", "required": ["pageCount", "pages"],
          "properties": {
            "pageCount": { "type": "integer", "minimum": 1 },
            "pages": {
              "type": "array",
              "items": {
                "type": "object", "required": ["width", "height", "text", "glyphs"],
                "properties": {
                  "width": { "type": "number" }, "height": { "type": "number" }, "text": { "type": "string" },
                  "glyphs": {
                    "type": "array",
                    "items": {
                      "type": "object", "required": ["text", "x", "y"],
                      "properties": { "text": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
