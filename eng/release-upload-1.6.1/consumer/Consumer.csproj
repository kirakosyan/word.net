<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><NuGetAudit>true</NuGetAudit>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="wordnet" Version="1.6.1" />
    <PackageReference Include="wordnet.Ocr" Version="1.6.1" />
    <PackageReference Include="wordnet.Fonts" Version="1.6.1" />
  </ItemGroup>
</Project>
