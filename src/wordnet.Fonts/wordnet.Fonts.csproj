<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>wordnet.Fonts</AssemblyName>
    <RootNamespace>WordNet.Fonts</RootNamespace>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <RepositoryUrl>https://github.com/kirakosyan/word.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageId>wordnet.Fonts</PackageId>
    <Description>OFL-licensed Liberation, Carlito and Caladea fallback font resources for wordnet.</Description>
    <PackageReleaseNotes>Bounded reporting and columns, DOCX/ODT exchange and review workflows, editable charts and OMML equations, Unicode 17 bidi and opt-in Hindi/native accessible PDF. Includes object fidelity review fixes. Cryptographic features remain unsupported. See the 1.3.0 release notes and documented profile limits.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT AND OFL-1.1</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/*.ttf" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Update="Resources/*-OFL.txt;Resources/provenance.json" Pack="true" PackagePath="licenses/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
