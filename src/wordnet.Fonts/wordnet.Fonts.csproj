<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>wordnet.Fonts</AssemblyName>
    <RootNamespace>WordNet.Fonts</RootNamespace>
    <Version>1.6.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <RepositoryUrl>https://github.com/kirakosyan/word.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageId>wordnet.Fonts</PackageId>
    <Description>OFL-licensed Liberation, Carlito and Caladea fallback font resources for wordnet.</Description>
    <PackageReleaseNotes>Fix import resource amplification in DOC, DOCX, EPUB, RTF, KF8, PDF and plain text. Add configurable block, run and image-placement limits while preserving ordinary scanned-PDF OCR and long text imports. See the 1.6.1 release notes for compatibility and qualification.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT AND OFL-1.1</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/*.ttf" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Update="Resources/*-OFL.txt;Resources/provenance.json" Pack="true" PackagePath="licenses/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
