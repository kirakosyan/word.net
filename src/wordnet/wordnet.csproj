<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net472;netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>WordNet</RootNamespace>
    <AssemblyName>wordnet</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>wordnet</PackageId>
    <Version>1.1.0-alpha.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>Armen Kirakosyan</Authors>
    <Description>Word conversion for .NET: DOC/DOCX exchanges with PDF, Markdown, text, EPUB, MOBI and AZW3, plus XPS output and local English OCR. Explicit fidelity diagnostics and bounded document processing.</Description>
    <PackageTags>word;docx;doc;pdf;markdown;epub;mobi;azw3;xps;converter;ocr;tesseract;dotnet;csharp;cross-platform</PackageTags>
    <PackageReleaseNotes>Enterprise export preview: managed DOC/DOCX to PDF and self-contained HTML, header/footer stories and fields, configurable fonts, deterministic diagnostics and Lenient degradation. Adds net462 assets. PDF import/OCR now requires the optional wordnet.Ocr package. See the enterprise audit for remaining fidelity and runtime qualification limits.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/kirakosyan/word.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kirakosyan/word.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'net462'">
    <Reference Include="System.IO.Compression" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../wordnet.Fonts/wordnet.Fonts.csproj" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="OpenMcdf" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PdfPig.Filters.Dct.JpegLibrary" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/Fonts/*.ttf" />
    <None Remove="Resources/Fonts/OFL.txt;Resources/Fonts/README.md" />
    <None Include="Resources/Fonts/OFL.txt" Pack="true" PackagePath="licenses/NotoSans-OFL.txt" />
    <None Include="Resources/Fonts/README.md" Pack="true" PackagePath="licenses/NotoSans-Provenance.md" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!-- Resolve the previous release's internal native-provider references for API
       comparison only. They are restored by the OCR/test projects, never core deps. -->
  <Target Name="BaselineProviderReferences" AfterTargets="_GetReferencePathFromInnerProjects">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../wordnet.Ocr/wordnet.Ocr.csproj"
             Targets="GetProviderReferencesForBaseline"
             Properties="TargetFramework=netstandard2.0;Configuration=$(Configuration);BuildProjectReferences=false">
      <Output ItemName="_BaselineProviderReferencePaths" TaskParameter="TargetOutputs" />
    </MSBuild>
    <ItemGroup>
      <PackageValidationReferencePath Update="@(PackageValidationReferencePath)">
        <ReferencePath>%(PackageValidationReferencePath.ReferencePath),@(_BaselineProviderReferencePaths, ',')</ReferencePath>
      </PackageValidationReferencePath>
    </ItemGroup>
  </Target>
</Project>
