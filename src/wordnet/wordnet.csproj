<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net472;netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>WordNet</RootNamespace>
    <AssemblyName>wordnet</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>wordnet</PackageId>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>Armen Kirakosyan</Authors>
    <Description>Bounded Word conversion, document editing and templates for .NET. DOC/DOCX exchanges with PDF, HTML, RTF, Markdown, text and ebooks; XPS output, semantic PDF, previews and optional local English OCR. Explicit fidelity diagnostics.</Description>
    <PackageTags>word;docx;doc;pdf;html;rtf;markdown;epub;mobi;azw3;xps;converter;templates;ocr;tesseract;dotnet;csharp;cross-platform</PackageTags>
    <PackageReleaseNotes>Direct HTML/ODT PDF export, immutable report chart binding, bounded scalar fields and structural comparison, improved font/table/note layout, final-column balancing, and qualified native table/story and separate managed-object PDF profiles. Includes roadmap review corrections. See the 1.4.0 release notes for compatibility and profile limits.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/kirakosyan/word.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kirakosyan/word.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.3.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'net462'">
    <Reference Include="System.IO.Compression" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../wordnet.Fonts/wordnet.Fonts.csproj" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="OpenMcdf" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PdfPig.Filters.Dct.JpegLibrary" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/Fonts/*.ttf" />
    <None Remove="Resources/Fonts/OFL.txt;Resources/Fonts/README.md" />
    <None Include="Resources/Fonts/OFL.txt" Pack="true" PackagePath="licenses/NotoSans-OFL.txt" />
    <None Include="Resources/Fonts/README.md" Pack="true" PackagePath="licenses/NotoSans-Provenance.md" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../tests/wordnet.Conversion.Tests/Fixtures/Unicode17/LICENSE" Pack="true" PackagePath="licenses/Unicode-3.0.txt" />
  </ItemGroup>
  <!-- Resolve the previous release's internal native-provider references for API
       comparison only. They are restored by the OCR/test projects, never core deps. -->
  <Target Name="BaselineProviderReferences" AfterTargets="_GetReferencePathFromInnerProjects">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../wordnet.Ocr/wordnet.Ocr.csproj"
             Targets="GetProviderReferencesForBaseline"
             Properties="TargetFramework=netstandard2.0;Configuration=$(Configuration);BuildProjectReferences=false">
      <Output ItemName="_BaselineProviderReferencePaths" TaskParameter="TargetOutputs" />
    </MSBuild>
    <ItemGroup>
      <PackageValidationReferencePath Update="@(PackageValidationReferencePath)">
        <ReferencePath>%(PackageValidationReferencePath.ReferencePath),@(_BaselineProviderReferencePaths, ',')</ReferencePath>
      </PackageValidationReferencePath>
    </ItemGroup>
  </Target>
</Project>
