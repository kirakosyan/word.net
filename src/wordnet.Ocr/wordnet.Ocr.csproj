<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net472;netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>WordNet.Ocr</RootNamespace>
    <AssemblyName>wordnet.Ocr</AssemblyName>
    <PackageId>wordnet.Ocr</PackageId>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <RepositoryUrl>https://github.com/kirakosyan/word.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Description>Optional native PDF import, local English OCR, Arabic typography and PNG preview providers for wordnet. Managed document export does not require this package.</Description>
    <PackageReleaseNotes>Typed fields and content controls, mixed and master-detail reports, bounded review histories and section/story comparison, rotated/fitted/linked text boxes and editable vectors. Includes layout and review corrections. See the 1.5.0 release notes for compatibility, qualification and combination limits.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../wordnet/wordnet.csproj" />
    <PackageReference Include="PdfPig.Rendering.Skia" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="GetProviderReferencesForBaseline" DependsOnTargets="ResolveReferences;FindReferenceAssembliesForReferences" Returns="@(ReferencePathWithRefAssemblies)" />
</Project>
